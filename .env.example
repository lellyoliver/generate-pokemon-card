# Token em https://huggingface.co/settings/tokens (Inference Providers)
HF_TOKEN=hf_SEU_TOKEN_AQUI
HF_MODEL=black-forest-labs/FLUX.1-Kontext-dev
HF_PROVIDER=fal-ai
PORT=3000
# Geração de imagem: 1 = ligada, 0 = desligada
HF_IMAGE_API=1
# Exige e-mail @ancora.com.br e 1 geração por pessoa (1 = ligado, 0 = desligado)
EMAIL_GATE=1
EMAIL_DOMAIN=ancora.com.br
# Proxy corporativo com certificado autoassinado (só desenvolvimento local):
# HF_INSECURE_TLS=1
